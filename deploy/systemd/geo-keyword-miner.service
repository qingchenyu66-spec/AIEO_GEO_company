[Unit]
Description=GEO Keyword Miner
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/geo/AIEO_GEO/services/keyword-miner
EnvironmentFile=-/opt/geo/AIEO_GEO/services/keyword-miner/.env
EnvironmentFile=-/data/geo/keyword-miner.env
Environment=HOST=127.0.0.1
Environment=PORT=8088
# sqlite=本地任务断点 (重启可续读 done / 中断标 error); 门户历史列表仍走 GEO MySQL
Environment=HISTORY_BACKEND=sqlite
Environment=HISTORY_DB=/data/geo/keyword-miner/history.db
ExecStart=/opt/geo/AIEO_GEO/backend/.venv/bin/python app.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
