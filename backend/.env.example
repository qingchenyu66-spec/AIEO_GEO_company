APP_NAME=GEO Monitor API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
# Sliding idle window (minutes): cookie/JWT TTL; real activity calls POST /auth/refresh to extend
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Hard cap from original login; refresh cannot extend beyond this
ACCESS_TOKEN_ABSOLUTE_EXPIRE_MINUTES=720
IDENTITY_TICKET_EXPIRE_MINUTES=30
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=geo_app
DATABASE_PASSWORD=replace-me
DATABASE_NAME=geo_monitor_system
REDIS_ENABLED=false
# Docker Compose ?? requirepass ??? REDIS_URL=redis://:??@redis:6379/0
# docker-compose requires a non-empty REDIS_PASSWORD (no default).
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_KEY_PREFIX=geo_monitor
REDIS_DEFAULT_TTL_SECONDS=60
REDIS_SCHEDULER_LOCK_TTL_SECONDS=1800
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_SUBMIT_RATE_LIMIT=10/m
CELERY_SYNC_RATE_LIMIT=30/m
CELERY_SCAN_SUBMIT_MAX_PROMPTS=50
CELERY_SYNC_BATCH_LIMIT=500
CELERY_SYNC_TERMINAL_GRACE_HOURS=24
SCHEDULE_TOLERANCE_MINUTES=60
MOLIZHISHU_SUBMIT_RATE_PER_MINUTE=30
MOLIZHISHU_SYNC_RATE_PER_MINUTE=60
MOLIZHISHU_RATE_LIMIT_MAX_WAIT_SECONDS=120
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
CELERY_QUEUE_SUBMIT_WARNING=50
CELERY_QUEUE_SUBMIT_CRITICAL=150
CELERY_QUEUE_SYNC_WARNING=100
CELERY_QUEUE_SYNC_CRITICAL=300
FLOWER_ENABLED=true
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=
FLOWER_URL=http://127.0.0.1:5555
# Cookie / CSRF???????
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_ENABLED=true
AUTH_EXPOSE_TOKEN_IN_BODY=false
TRUSTED_HOSTS=127.0.0.1,localhost
MONITOR_WEBHOOK_URL=
MONITOR_ALERT_COOLDOWN_SECONDS=900
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
