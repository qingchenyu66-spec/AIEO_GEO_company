APP_NAME=GEO Monitor API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
IDENTITY_TICKET_EXPIRE_MINUTES=30
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=geo_app
DATABASE_PASSWORD=replace-me
DATABASE_NAME=geo_monitor_system
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_KEY_PREFIX=geo_monitor
REDIS_DEFAULT_TTL_SECONDS=60
REDIS_SCHEDULER_LOCK_TTL_SECONDS=1800
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_SUBMIT_RATE_LIMIT=10/m
CELERY_SYNC_RATE_LIMIT=30/m
CELERY_SCAN_SUBMIT_MAX_PROMPTS=50
CELERY_SYNC_BATCH_LIMIT=500
CELERY_SYNC_TERMINAL_GRACE_HOURS=24
SCHEDULE_TOLERANCE_MINUTES=60
MOLIZHISHU_SUBMIT_RATE_PER_MINUTE=30
MOLIZHISHU_SYNC_RATE_PER_MINUTE=60
MOLIZHISHU_RATE_LIMIT_MAX_WAIT_SECONDS=120
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
CELERY_QUEUE_SUBMIT_WARNING=50
CELERY_QUEUE_SUBMIT_CRITICAL=150
CELERY_QUEUE_SYNC_WARNING=100
CELERY_QUEUE_SYNC_CRITICAL=300
FLOWER_ENABLED=true
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=
FLOWER_URL=http://127.0.0.1:5555
MONITOR_WEBHOOK_URL=
MONITOR_ALERT_COOLDOWN_SECONDS=900
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 模力指数监测 API（必填才能提交/同步监测任务）
MOLIZHISHU_TOKEN=

# DeepSeek Open API（可选；配置后品牌情绪词云优先用 AI 提炼关键词）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SENTIMENT_KEYWORD_ENABLED=true
# 配置 DEEPSEEK_API_KEY 后，报告生成将调用 DeepSeek 撰写结论与诊断建议
DEEPSEEK_REPORT_ENABLED=true
