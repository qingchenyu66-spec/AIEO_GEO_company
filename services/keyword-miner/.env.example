# 复制为 .env 或由 setup_keyword_miner.sh 自动生成
# 必须填写 LLM_API_KEY，否则生成接口会报错

# GEO 会话门禁 (挖词 API 二次校验)
GEO_GATE_URL=http://127.0.0.1:8001/api/v1/keyword-miner/gate

# 大模型 API Key（可用 backend/.env 的 DEEPSEEK_API_KEY）
LLM_API_KEY=

# OpenAI 兼容接口地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# 生成温度
LLM_TEMPERATURE=0.7

# 服务监听：本地默认 8080 (与 Vite 代理一致)；生产由 systemd 覆写为 127.0.0.1:8088
HOST=127.0.0.1
PORT=8080

# 历史：生产 off（落 GEO MySQL）；本地可 sqlite
HISTORY_BACKEND=off
# HISTORY_DB=/data/geo/keyword-miner/history.db

# 可选：额外 CORS 源，逗号分隔
# CORS_ORIGINS=https://www.example.com
